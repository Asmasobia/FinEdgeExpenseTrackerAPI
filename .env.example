# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is not. Nothing here may ever hold a real secret —
# the whole point is that it is safe to commit, so a new cloner can see WHICH
# variables are needed without being handed yours.

# Secret used to sign and verify JWTs. Any value works for local development, but it
# must be long and random: the signature is the only thing preventing someone from
# minting their own token and claiming to be any user. A short or guessable secret is
# equivalent to no authentication at all, because an attacker can brute-force it
# offline from a single captured token — no requests to your server needed.
#
# Generate one with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Port the HTTP server listens on. Optional — defaults to 3000.
PORT=3000

# Set to `production` when deploying. Anything else is treated as development.
# `test` has one special behaviour: it allows a fixed dummy JWT secret so the test
# suite runs without a .env file. See src/config.js.
NODE_ENV=development
